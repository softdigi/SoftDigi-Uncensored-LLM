<?xml version="1.0" encoding="utf-8"?>
<!-- SoftDigi AI launch screen: dark brand background with the logo, name and tagline centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/softdigi_launch_background" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_brand" />
    </item>
</layer-list>
